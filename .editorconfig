# EditorConfig is awesome: https://editorconfig.org

root = true

[*]
charset = utf-8
end_of_line = lf
insert_final_newline = true
indent_style = space
indent_size = 4
use_tab = false
trim_trailing_whitespace = true

[*.lua]
indent_size = 2
indent_style = space

[*.nix]
indent_style = space
indent_size = 2

[*.{toml,toml.tmpl}]
indent_style = space
indent_size = 2
